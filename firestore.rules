rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "oryhbrx22@gmail.com";
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn() &&
        (isAdmin() || request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /leaders/{leaderId} {
      allow read: if isAdmin() || (signedIn() && leaderId == request.auth.uid);
      allow create, update: if signedIn() &&
        (isAdmin() || leaderId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
